# trade-finance-rails — environment
#
# Copy to `.env.local` and fill in. `.env.local` is gitignored; this file is
# committed and must never contain a real value.
#
# The rule, from STACK_RULES.md: anything NEXT_PUBLIC_ is a public fact about a
# public testnet and is safe to inline into a browser bundle. Anything else is
# server-side, read at request time, and never added to the host platform
# during Develop.

# ─── Circle (sandbox only — never a production key) ──────────────────────────
# Console: https://app-sandbox.circle.com/developer → API Keys
# Verify:  curl -s https://api-sandbox.circle.com/v1/configuration \
#            -H "Authorization: Bearer $CIRCLE_API_KEY"
CIRCLE_API_KEY=
# Set once webhooks are configured (cycle 2). Every webhook is signature-checked
# before it is trusted; an unsigned callback is a claim, not evidence.
CIRCLE_WEBHOOK_SECRET=
CIRCLE_API_BASE=https://api-sandbox.circle.com

# ─── Cycle 2: the fiat rail feature flag ─────────────────────────────────────
# ABSENT MEANS OFF, and absence is never an error. Checked on the server as
# well as in the browser — a public flag is never a permission.
NEXT_PUBLIC_ENABLE_CIRCLE_RAIL=

# ─── Database (cycle 0) ──────────────────────────────────────────────────────
# Neon Postgres. Migrations live in this repo from the first commit — the
# specific thing the predecessor schema never had.
DATABASE_URL=

# ─── Chain (public facts) ────────────────────────────────────────────────────
# Chain id is ALSO passed explicitly per transaction in the verifier. This var
# is a default, not the source of truth — the predecessor hard-coded the chain
# in a module constant while declaring this var and never reading it, which is
# a mistake a multi-rail verifier cannot inherit.
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_EXPLORER_URL=https://sepolia.basescan.org

# Real Circle testnet USDC on Base Sepolia.
NEXT_PUBLIC_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# A MOCK ERC-20 deployed by this project, standing in for a token with no
# public testnet. Every surface that renders it must say so — this is a
# provenance marker, not a status. Set in cycle 6.
NEXT_PUBLIC_MOCK_TOKEN_ADDRESS=

# ─── Demo wallets (cycle 1) — TESTNET ONLY ───────────────────────────────────
# Four repo-managed demo wallets move the testnet USDC (design 2026-09-07).
# Generate keys locally (viem generatePrivateKey); fund the derived addresses
# via docs/demo-wallets-runbook.md. Server-side only, read at request time.
# NEVER a real-money key; never committed; never NEXT_PUBLIC_.
WALLET_FUNDER_PK=
WALLET_PLATFORM_PK=
WALLET_SUPPLIER_PK=
WALLET_DEBTOR_PK=
